# WhatsApp Cloud API Configuration
# Get these values from https://developers.facebook.com/apps

# Phone Number ID (from WhatsApp > API Setup)
WHATSAPP_PHONE_NUMBER_ID=your_phone_number_id_here

# WhatsApp Business Account ID (from WhatsApp > API Setup)
WHATSAPP_BUSINESS_ACCOUNT_ID=your_business_account_id_here

# Access Token (Generate in Meta App Dashboard)
# For testing: Use temporary token (valid 24 hours)
# For production: Create System User token
WHATSAPP_ACCESS_TOKEN=your_access_token_here

# API Version (leave as is)
WHATSAPP_API_VERSION=v21.0
